{
  "name": "pica-comic-statistics",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:node": "nuxt build --preset=node-server",
    "build:cf": "nuxt build --preset=cloudflare-pages",
    "build:docker": "docker build -t picacomic-statistics:ci .",
    "prepare": "husky",
    "lint": "eslint .",
    "typecheck": "nuxt prepare && tsc -p .nuxt/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "echarts-wordcloud": "^2.1.0",
    "lucide-vue-next": "^0.468.0",
    "nuxt": "^4.1.0",
    "openai": "^5.12.2",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.21",
    "vue-echarts": "^7.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@nuxt/eslint": "^1.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.36.0",
    "fake-indexeddb": "^6.2.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,vue}": "eslint --fix --no-warn-ignored"
  }
}
